import re
p = "AndroidManifest.xml"
s = open(p).read()

s = re.sub(r'\s*<!-- Launcher identity.*?-->\s*<activity-alias.*?</activity-alias>', '\n', s, flags=re.S)

launcher = '''
        <activity android:name="com.retroarch.browser.LauncherActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
'''
key = '<activity android:name="com.retroarch.browser.debug.CoreSideloadActivity"'
s = s.replace(key, launcher + '        ' + key, 1)
open(p, "w").write
